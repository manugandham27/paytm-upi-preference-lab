datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Respondent {
  id                   String        @id @default(cuid())
  anonymousId          String        @unique
  ageRange             String        // 18-24, 25-34, 35-44, 45+
  occupation           String        // Student, Working Professional, Business Owner, Freelancer, Kirana Merchant, Other
  city                 String
  locality             String?
  primaryUpiApp        String        // Paytm, Google Pay, PhonePe, BHIM, Amazon Pay, Bank UPI app, Other
  secondaryApps        String        // JSON array string
  usedPaytmLast90Days  Boolean       // Screener Q1
  monthlyPaymentCount  Int
  monthlyPaymentValue  Float
  trackAEligible       Boolean       // True if usedPaytmLast90Days === true AND primaryUpiApp !== 'Paytm'
  completionStatus     String        // INCOMPLETE, VALID_VOC, IN_DEPTH, INVALID_SCREENING
  isDemo               Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  vocResponses         VocResponse[]
  inDepthInterview     InDepthInterview?
  solutionValidations  SolutionValidation[]
  barriers             Barrier[]
}

model VocResponse {
  id                      String      @id @default(cuid())
  
  // OFFICIAL 12 TEMPLATE COLUMNS
  vocId                   String      @default("VOC-001") // Col 1: VOC ID (VOC-001 to VOC-050)
  date                    String      @default("2026-09-15") // Col 2: Date (YYYY-MM-DD)
  respondentType          String      @default("Consumer") // Col 3: Respondent type (Consumer / Merchant)
  cityArea                String      @default("Mumbai") // Col 4: City / area
  profileCategory         String      @default("Working Professional") // Col 5: Profile / category
  upiAppsUsed             String      @default("Google Pay, Paytm") // Col 6: UPI apps used
  primaryUpiApp           String      @default("Google Pay") // Col 7: Primary UPI app used
  whyChosenExact          String      @default("") // Col 8: Why was it chosen? (exact words)
  paytmUsageWhenWhy       String      @default("") // Col 9: When or why is Paytm used? Or not used if switched from Paytm?
  analystNeedBarrier      String      @default("") // Col 10: Need, barrier or motivation to switch (Analyst Derived)
  opportunityIdea         String      @default("") // Col 11: Opportunity / idea
  keyQuote                String      @default("") // Col 12: Key quote

  // Extended Research Properties
  respondentId            String?
  respondent              Respondent?  @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  occasionCategory        String      @default("Medium/low-value + high-frequency")
  occasionType            String      @default("Grocery")
  transactionValueRange   String      @default("₹100-₹500")
  frequency               String      @default("Daily")
  recentTxDescription     String      @default("")
  appUsed                 String      @default("Google Pay")
  alternativeConsidered   String?     @default("Paytm")
  whyChosen               String      @default("")
  whyNotPaytm             String      @default("")
  paytmLastUsedExperience String      @default("")
  verbatimQuote           String      @default("")
  researcherNeed          String      @default("")
  researcherMotivation    String      @default("")
  researcherBarrier       String      @default("")
  researcherInsight       String      @default("")
  evidenceSummary         String      @default("")
  interviewDepth          String      @default("STANDARD") // STANDARD or IN_DEPTH
  isDemo                  Boolean     @default(false)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  barriers                Barrier[]
}

model InDepthInterview {
  id                 String      @id @default(cuid())
  respondentId       String      @unique
  respondent         Respondent  @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  promptAnswersJson  String      // JSON string of 16-point answers
  observations       String      // Researcher observations
  keyQuotesJson      String      // JSON array of key verbatims
  emergingInsights   String      // Emerging insights from interview
  isDemo             Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Barrier {
  id            String       @id @default(cuid())
  category      String       // Convenience, Reliability, Speed, Habit, Trust, Rewards/value, Merchant acceptance/cues, Feature awareness, User interface, Transaction history/records, Social influence, Other
  description   String
  respondentId  String?
  respondent    Respondent?  @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  vocId         String?
  voc           VocResponse? @relation(fields: [vocId], references: [id], onDelete: Cascade)
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model Insight {
  id             String   @id @default(cuid())
  title          String
  observation    String   // What respondents actually did
  evidenceCount  Int      // How many respondents showed this behavior
  verbatimQuote  String   // Representative verbatim
  pattern        String   // Common behavior pattern
  barrier        String   // Barrier preventing Paytm usage
  opportunity    String   // Where Paytm can intervene
  implication    String   // Recommendation for product team
  linkedVocIds   String   // JSON array of VOC IDs
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OpportunityModel {
  id                     String   @id @default(cuid())
  segmentName            String
  targetUserCount        Int
  avgMonthlyFreq         Float
  avgTicketSize          Float
  potentialShareShiftPct Float
  calculatedGmvPotential Float
  assumptionsJson        String   // JSON string of assumptions
  isDemo                 Boolean  @default(false)
  createdAt              DateTime @default(now())
}

model SolutionConcept {
  id                        String               @id @default(cuid())
  name                      String
  problemAddressed          String
  targetUser                String
  relevantOccasion          String
  vocEvidence               String
  userBenefit               String
  paytmBenefit              String
  merchantBenefit           String?
  expectedBehaviorChange    String
  implementationRequirements String
  potentialRisks            String
  scalabilityScore          Int                  // 1 to 10
  measurementMetric         String
  isDemo                    Boolean              @default(false)
  createdAt                 DateTime             @default(now())

  validations               SolutionValidation[]
}

model SolutionValidation {
  id                     String          @id @default(cuid())
  solutionId             String
  solution               SolutionConcept @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  respondentId           String?
  respondent             Respondent?     @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  solvesProblem          Boolean
  wouldChangeApp         Boolean
  targetOccasion         String
  expectedFrequency      String
  perceivedBlockers      String
  improvementSuggestions String
  existingAlternative    String
  isDemo                 Boolean         @default(false)
  createdAt              DateTime        @default(now())
}

model ResearchMetadata {
  id                  String   @id @default("default")
  totalVocTarget      Int      @default(50)
  inDepthTarget       Int      @default(10)
  teamName            String   @default("Team_Paytm_Innovators")
  activeMode          String   @default("REAL") // REAL or DEMO
  lastAuditTimestamp  DateTime @default(now())
}
